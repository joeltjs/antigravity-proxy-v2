# ── Antigravity Proxy credentials ─────────────────────────────
# Copy file ini ke .env lalu isi nilai asli. JANGAN commit .env!
# Priority: environment variable > file .env > config.json

# API key untuk akses endpoint /v1/* (generate sendiri, contoh: openssl rand -hex 16)
AG_PROXY_API_KEY=your-s…here

# Dashboard login (Basic Auth)
AG_DASHBOARD_USER=admin
AG_DASHBOARD_PASSWORD=your-d…here

# Google Cloud Console OAuth client (OAuth 2.0 Client ID)
OAUTH_ACCESS_KEY=your-o…here
OAUTH_SECRET_KEY=your-o…here

# Redirect URI Google OAuth (harus PERSIS sama dengan yang terdaftar di Google Cloud Console)
# Contoh: http://IP-VPS-KAMU:20130/auth/callback
OAUTH_REDIRECT_URI=http://your-vps-ip:20130/auth/callback
