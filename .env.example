# ── Antigravity Proxy credentials ─────────────────────────────
# Copy this file to .env and fill in real values. DO NOT commit .env!
# Priority: environment variable > .env file > config.json

# API key for accessing /v1/* endpoints (generate your own, e.g. openssl rand -hex 16)
AG_PROXY_API_KEY=your-s...here

# Dashboard login (Basic Auth)
AG_DASHBOARD_USER=admin
AG_DASHBOARD_PASSWORD=your-d...here

# Google Cloud Console OAuth credentials (Optional — for web-based OAuth login like 9router)
OAUTH_ACCESS_KEY=your-o...here
OAUTH_SECRET_KEY=your-o...here

# Google OAuth Redirect URI (Optional — must match Google Cloud Console configuration)
# Example: http://YOUR-SERVER-IP:20130/auth/callback
OAUTH_REDIRECT_URI=http://your-vps-ip:20130/auth/callback
